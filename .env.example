# Copy to .env and fill in. .env is git-ignored — never commit real values.
# Backend URLs and cluster access are in the internal handover document; see README section 3.3.
#
# Only VITE_* variables are exposed to the browser.
# RAG_API_URL and SHIM_* are read by Node (the dev shim) and never shipped to the client.

# ---------------------------------------------------------------------------
# Client (VITE_*)
# ---------------------------------------------------------------------------

# Proxy target for `npm run dev` (a real MediaWiki rest.php).
# Ignored by dev:mock and dev:shim.
VITE_API_URL=https://example.com/api

# Fallback locale baked in at build time: "he" (default) or "en".
# Note: window.KZChatbotConfig.slugs still overrides these strings at runtime.
VITE_LOCALE=he

# Selects the local dev backend. Normally you do NOT set this by hand —
# the dev:mock / dev:shim scripts set it for you.
#   mockup → in-process canned responses, no backend needed
#   shim   → in-process shim forwarding to a real RAG
#   unset  → proxy to VITE_API_URL
# VITE_MODE=mockup

# ---------------------------------------------------------------------------
# Shim mode only (npm run dev:shim / npm run shim) — see README-shim-mode.md
# ---------------------------------------------------------------------------

# Base URL of the RAG backend. For the staging RAG, tunnel first:
#   kubectl port-forward -n default svc/kz-stage 5000:80
RAG_API_URL=http://localhost:5000

# Listen port for the standalone shim (`npm run shim`). Ignored in-process.
SHIM_PORT=3002

# Send page_id (derived from the referrer) to the RAG.
# Mirrors the KZChatbotSendPageId MediaWiki config. Set "false" to disable.
SHIM_SEND_PAGE_ID=true

# Fault-injection limits for testing the error UI. 0 = off (default).
# The real limits live in MediaWiki; these only exist to exercise the front-end.
SHIM_MAX_QUESTIONS=0    # per-user question cap  → HTTP 429 (daily-limit UI)
SHIM_QUESTION_CHARS=0   # question length cap    → HTTP 413
SHIM_FEEDBACK_CHARS=0   # feedback length cap    → HTTP 400
